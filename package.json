{
  "name": "m31-agent",
  "displayName": "M31 Agent",
  "description": "AI-powered coding assistant that integrates with OpenRouter AI",
  "version": "0.1.0",
  "icon": "resources/images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "publisher": "m31-ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/M31Lab/Agent"
  },
  "categories": [
    "AI",
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "ai",
    "assistant",
    "coding",
    "openrouter",
    "openai",
    "claude"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/debug-extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "m31-agent-sidebar",
          "title": "M31 Agent",
          "icon": "resources/icons/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "m31-agent-sidebar": [
        {
          "id": "m31-agent.dashboardView",
          "name": "Dashboard",
          "icon": "resources/icons/commands/dashboard-view.svg"
        },
        {
          "id": "m31-agent.chatView",
          "name": "AI Chat",
          "icon": "resources/icons/commands/chat-view.svg"
        },
        {
          "id": "m31-agent.codeExplorerView",
          "name": "Code Explorer",
          "icon": "resources/icons/commands/codebase-view.svg"
        },
        {
          "id": "m31-agent.modelConfigView",
          "name": "AI Models",
          "icon": "resources/icons/commands/settings.svg"
        },
        {
          "id": "m31-agent.performanceView",
          "name": "Performance",
          "icon": "resources/icons/commands/performance-view.svg"
        },
        {
          "id": "m31-agent.diagnosticsView",
          "name": "Diagnostics",
          "icon": "resources/icons/commands/diagnostics-view.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "m31-agent.showChat",
        "title": "Show Chat",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/chat.svg",
          "dark": "resources/icons/commands/chat.svg"
        }
      },
      {
        "command": "m31-agent.configureSettings",
        "title": "Configure Settings",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/settings.svg",
          "dark": "resources/icons/commands/settings.svg"
        }
      },
      {
        "command": "m31-agent.quickChat",
        "title": "Quick Chat",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/chat.svg",
          "dark": "resources/icons/commands/chat.svg"
        }
      },
      {
        "command": "m31-agent.explainCode",
        "title": "Explain Code",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/code.svg",
          "dark": "resources/icons/commands/code.svg"
        }
      },
      {
        "command": "m31-agent.generateCode",
        "title": "Generate Code",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/code.svg",
          "dark": "resources/icons/commands/code.svg"
        }
      },
      {
        "command": "m31-agent.runCommand",
        "title": "Run Command",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.navigateCodebase",
        "title": "Navigate Codebase",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.codeAnalysis.analyzeCodebase",
        "title": "Analyze Codebase Structure",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.webSearch.search",
        "title": "M31-Agent: Search the Web",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.webSearch.configure",
        "title": "M31-Agent: Configure Web Search Provider",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.checkpoint.compare",
        "title": "M31-Agent: Compare Checkpoints",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.checkpoint.restoreWithOptions",
        "title": "M31-Agent: Restore Checkpoint with Options",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.showAll",
        "title": "M31-Agent: Show All Diagnostics",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.showErrors",
        "title": "M31-Agent: Show Errors",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.monitorCurrentFile",
        "title": "M31-Agent: Monitor Current File Diagnostics",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.updateOptions",
        "title": "M31-Agent: Update Diagnostics Options",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.showWarnings",
        "title": "M31-Agent: Show Warnings",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.diagnostics.configureDiagnostics",
        "title": "M31-Agent: Configure Diagnostics",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.mcp.addTool",
        "title": "M31-Agent: Add Custom Tool",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.mcp.listTools",
        "title": "M31-Agent: Manage Custom Tools",
        "category": "M31-Agent"
      },
      {
        "command": "m31-agent.git.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.code.addLogs",
        "title": "Add Logs to Selection",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.code.shareCode",
        "title": "Share Code Link",
        "category": "M31 Agent"
      },
      {
        "command": "m31-agent.configureApiKey",
        "title": "Configure API Key",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/key.svg",
          "dark": "resources/icons/commands/key.svg"
        }
      },
      {
        "command": "m31-agent.clearApiKey",
        "title": "Clear API Key",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/key.svg",
          "dark": "resources/icons/commands/key.svg"
        }
      },
      {
        "command": "m31-agent.selectModel",
        "title": "Select AI Model",
        "category": "M31 Agent",
        "icon": {
          "light": "resources/icons/commands/settings.svg",
          "dark": "resources/icons/commands/settings.svg"
        }
      }
    ],
    "keybindings": [
      {
        "command": "m31-agent.quickChat",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus || editorFocus"
      },
      {
        "command": "m31-agent.explainCode",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorHasSelection"
      }
    ],
    "configuration": {
      "title": "M31 Agent",
      "properties": {
        "m31-agent.modelId": {
          "type": "string",
          "default": "openai/gpt-4o",
          "description": "AI model to use for code generation and chat",
          "enum": [
            "openai/gpt-4o",
            "openai/gpt-4-turbo",
            "openai/gpt-3.5-turbo",
            "anthropic/claude-3-opus",
            "anthropic/claude-3-sonnet",
            "anthropic/claude-3-haiku",
            "google/gemini-pro"
          ],
          "enumDescriptions": [
            "OpenAI GPT-4o - Most capable general-purpose model",
            "OpenAI GPT-4 Turbo - Highly capable general-purpose model",
            "OpenAI GPT-3.5 Turbo - Fast and economical general-purpose model",
            "Anthropic Claude 3 Opus - Highest capability Claude model",
            "Anthropic Claude 3 Sonnet - Balanced capability and performance",
            "Anthropic Claude 3 Haiku - Fast and efficient Claude model",
            "Google Gemini Pro - Google's advanced large language model"
          ]
        },
        "m31-agent.maxTokens": {
          "type": "number",
          "default": 1024,
          "minimum": 256,
          "maximum": 8192,
          "description": "Maximum number of tokens to generate in responses"
        },
        "m31-agent.temperature": {
          "type": "number",
          "default": 0.7,
          "minimum": 0,
          "maximum": 1,
          "description": "Temperature for generation (0-1). Lower values make responses more focused, higher values increase creativity."
        },
        "m31-agent.requireConfirmation": {
          "type": "boolean",
          "default": true,
          "description": "Require confirmation before executing commands or writing files"
        },
        "m31-agent.apiEndpoint": {
          "type": "string",
          "default": "https://openrouter.ai/api/v1",
          "description": "OpenRouter API endpoint"
        },
        "m31-agent.enableTelemetry": {
          "type": "boolean",
          "default": true,
          "description": "Enable telemetry to help improve the extension"
        },
        "m31-agent.logLevel": {
          "type": "string",
          "default": "info",
          "enum": [
            "debug",
            "info",
            "warning",
            "error",
            "none"
          ],
          "description": "Log level for the extension"
        },
        "m31-agent.showWelcomeOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show welcome message when the extension starts"
        },
        "m31-agent.search.provider": {
          "type": "string",
          "enum": [
            "bing",
            "google",
            "duckduckgo",
            "custom"
          ],
          "default": "bing",
          "description": "Web search provider to use"
        },
        "m31-agent.search.bingApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Bing search"
        },
        "m31-agent.search.googleApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Google search"
        },
        "m31-agent.search.googleEngineId": {
          "type": "string",
          "default": "",
          "description": "Custom search engine ID for Google search"
        },
        "m31-agent.search.customEndpoint": {
          "type": "string",
          "default": "",
          "description": "Custom search endpoint URL"
        },
        "m31-agent.search.customApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for custom search endpoint"
        },
        "m31-agent.diagnostics.includeInformation": {
          "type": "boolean",
          "default": false,
          "description": "Include information-level diagnostics in monitoring"
        },
        "m31-agent.diagnostics.includeHints": {
          "type": "boolean",
          "default": false,
          "description": "Include hint-level diagnostics in monitoring"
        },
        "m31-agent.diagnostics.trackHistory": {
          "type": "boolean",
          "default": true,
          "description": "Track diagnostic history"
        },
        "m31-agent.diagnostics.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "node_modules/**",
            ".git/**"
          ],
          "description": "Glob patterns for files to exclude from diagnostics monitoring"
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "m31-agent.explainCode",
          "when": "editorHasSelection",
          "group": "m31-agent"
        },
        {
          "command": "m31-agent.generateCode",
          "group": "m31-agent"
        },
        {
          "command": "m31-agent.git.generateCommitMessage",
          "group": "m31-agent"
        },
        {
          "command": "m31-agent.code.addLogs",
          "when": "editorHasSelection",
          "group": "m31-agent"
        },
        {
          "command": "m31-agent.code.shareCode",
          "when": "editorHasSelection",
          "group": "m31-agent"
        }
      ],
      "scm/title": [
        {
          "command": "m31-agent.git.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "prepare": "husky install",
    "type-check": "tsc --noEmit",
    "build": "npm run lint && npm run type-check && npm run package",
    "evals": "npm run evals:all",
    "evals:all": "node evals/run-all.js",
    "evals:benchmarks": "node evals/benchmarks/performance.js",
    "evals:integration": "node evals/integration/run.js",
    "evals:scenarios": "node evals/scenarios/run.js",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "check-deps": "node scripts/check-dependencies.js",
    "prerelease": "node scripts/prerelease.js",
    "spell-check": "codespell",
    "format": "prettier --write .",
    "clean": "rimraf dist out .vscode-test",
    "ci": "npm run lint && npm run type-check && npm run test",
    "docs": "typedoc --out docs/api src/",
    "postinstall": "node scripts/postinstall.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.2",
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.2",
    "@types/node": "^20.17.32",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "@types/uuid": "^9.0.4",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.7.3",
    "@typescript-eslint/parser": "^6.7.3",
    "@vscode/test-electron": "^2.3.4",
    "@vscode/vsce": "^2.21.0",
    "chalk": "^5.4.1",
    "codespell": "^1.1.7",
    "css-loader": "^6.8.1",
    "eslint": "^8.50.0",
    "glob": "^10.4.5",
    "husky": "^9.1.7",
    "mocha": "^10.2.0",
    "rimraf": "^6.0.1",
    "semver": "^7.7.1",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.4.4",
    "typedoc": "^0.28.3",
    "typescript": "^5.8.3",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "cheerio": "^1.0.0-rc.12",
    "lru-cache": "^7.14.1",
    "minimatch": "^9.0.3",
    "puppeteer-core": "^21.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "uuid": "^9.0.0"
  }
}
